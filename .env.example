# Copy to .env (git-ignored). Every task reads it.
# The console's address on your LAN (FTP on 2121, klog on 3232).
PS5_HOST=192.168.1.50
# The client's and the probe's title ids. Leave them as they are.
TITLE_ID=PPSA99724
TITLE_ID_PROBE=PPSA99725
# Only when the console's FTP server is not on 2121 or wants a login:
# PS5_FTP_PORT=2121
# PS5_FTP_USER=anonymous
# PS5_FTP_PASSWORD=
