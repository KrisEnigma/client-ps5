# Copy to .env (git-ignored). Task reads it.
# The console's address on your LAN (FTP on 2121, ELF loader on 9021, klog on 3232).
PS5_HOST=192.168.1.50
# Title id the build packages and deploys to /data/homebrew/<TITLE_ID>/.
TITLE_ID=PPSA99724
# The probe's own title (task package-probe).
TITLE_ID_PROBE=PPSA99725
# Payload SDK root (ps5-payload-dev/sdk release). The Docker image sets it for you.
PS5_PAYLOAD_SDK=/opt/ps5-payload-sdk
